{
    "projects": {
        "smartdar": {
            "api": {
                "port": 54321,
                "schemas": [
                    "public",
                    "graphql_public"
                ],
                "string_prefix_characters": "_",
                "max_rows": 1000
            },
            "db": {
                "port": 54322,
                "major_version": 15
            },
            "realtime": {
                "enabled": true,
                "max_bytes_per_second": 1000000,
                "max_channel_subscriptions": 500,
                "max_concurrent_users": 200,
                "max_joins_per_second": 500
            },
            "edge_runtime": {
                "policy": "per_worker"
            }
        }
    },
    "functions": {
        "receive-sensor-data": {
            "enabled": true,
            "verify_jwt": false,
            "import_map": "./functions/_shared/import_map.json"
        }
    }
}